# Leave blank to use the same-origin /v1 API (Vite proxies to localhost:8000 in dev).
VITE_API_BASE_URL=
VITE_DEV_API_PROXY=http://127.0.0.1:8000
# Public OpenStreetMap raster tile endpoint; override with a compatible OSM tile provider.
VITE_BASEMAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
